      "sourceData": "{{(() => { const tableData = InboundDeliveryTable.processedTableData || []; return tableData.length > 0 ? tableData.map((currentRow, currentIndex) => (\n(() => {\n  const status = currentRow.Status || currentRow.status || \"\";\n\n  const items = [\n    { label: \"Edit\", value: \"EDIT\", isDisabled: [\"RECEIVED\", \"CANCELLED\"].includes(status) },\n    { label: \"Print\", value: \"PRINT\", isDisabled: false }\n  ];\n\n  if (status === \"DRAFT\") {\n    items.push(\n      { label: \"Set In Transit\", value: \"IN_TRANSIT\", isDisabled: false },\n      { label: \"Cancel\", value: \"CANCELLED\", isDisabled: false }\n    );\n  }\n\n  if (status === \"IN_TRANSIT\") {\n    items.push(\n      { label: \"Set Arrived\", value: \"ARRIVED\", isDisabled: false },\n      { label: \"Cancel\", value: \"CANCELLED\", isDisabled: false }\n    );\n  }\n\n  if (status === \"ARRIVED\") {\n    items.push(\n      { label: \"Start Receiving\", value: \"RECEIVING\", isDisabled: false },\n      { label: \"Cancel\", value: \"CANCELLED\", isDisabled: false }\n    );\n  }\n\n  if (status === \"RECEIVING\") {\n    items.push(\n      { label: \"Create Goods Receipt\", value: \"CREATE_GR\", isDisabled: false },\n      { label: \"Cancel\", value: \"CANCELLED\", isDisabled: false }\n    );\n  }\n\n  if (status === \"RECEIVED\") {\n    items.push(\n      { label: \"Already Received\", value: \"NONE\", isDisabled: true }\n    );\n  }\n\n  if (status === \"CANCELLED\") {\n    items.push(\n      { label: \"Cancelled\", value: \"NONE\", isDisabled: true }\n    );\n  }\n\n  return items;\n})()\n)) : \n(() => {\n  const status = currentRow.Status || currentRow.status || \"\";\n\n  const items = [\n    { label: \"Edit\", value: \"EDIT\", isDisabled: [\"RECEIVED\", \"CANCELLED\"].includes(status) },\n    { label: \"Print\", value: \"PRINT\", isDisabled: false }\n  ];\n\n  if (status === \"DRAFT\") {\n    items.push(\n      { label: \"Set In Transit\", value: \"IN_TRANSIT\", isDisabled: false },\n      { label: \"Cancel\", value: \"CANCELLED\", isDisabled: false }\n    );\n  }\n\n  if (status === \"IN_TRANSIT\") {\n    items.push(\n      { label: \"Set Arrived\", value: \"ARRIVED\", isDisabled: false },\n      { label: \"Cancel\", value: \"CANCELLED\", isDisabled: false }\n    );\n  }\n\n  if (status === \"ARRIVED\") {\n    items.push(\n      { label: \"Start Receiving\", value: \"RECEIVING\", isDisabled: false },\n      { label: \"Cancel\", value: \"CANCELLED\", isDisabled: false }\n    );\n  }\n\n  if (status === \"RECEIVING\") {\n    items.push(\n      { label: \"Create Goods Receipt\", value: \"CREATE_GR\", isDisabled: false },\n      { label: \"Cancel\", value: \"CANCELLED\", isDisabled: false }\n    );\n  }\n\n  if (status === \"RECEIVED\") {\n    items.push(\n      { label: \"Already Received\", value: \"NONE\", isDisabled: true }\n    );\n  }\n\n  if (status === \"CANCELLED\") {\n    items.push(\n      { label: \"Cancelled\", value: \"NONE\", isDisabled: true }\n    );\n  }\n\n  return items;\n})()\n })()}}",
