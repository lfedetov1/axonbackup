  "onRowSelected": "{{\n  (() => {\n    const row = InventoryCountTable.selectedRow || {};\n\n    const id =\n      row.inventoryCountId ||\n      row.documentId ||\n      row.id ||\n      row.ID ||\n      row[\"Inventory Count ID\"] ||\n      row[\"Document ID\"];\n\n    storeValue(\"currentInventoryCountId\", id);\n    storeValue(\"currentInventoryCountNumber\", row[\"Count Number\"] || row.documentNumber || \"\");\n    storeValue(\"currentInventoryCountStatus\", row.Status || row.status || \"\");\n    storeValue(\"currentInventoryCountWarehouseText\", `${row[\"Warehouse Code\"] || \"\"} - ${row.Warehouse || \"\"}`);\n\n    ListInventoryCountDocuments.run();\n    ListInventoryCountVariance.run();\n\n    return id;\n  })()\n}}\n",
